__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
build/
dist/
.venv/
venv/
.env
benchmarks/results.json
benchmarks/live_report.json
benchmarks/multi_repo_report.json
benchmarks/accuracy_report.json
benchmarks/django_33_prompts.json
benchmarks/polyglot_33_results.json
.benchmarks/
.prism/
# repo-root scratch scripts used for one-off runtime instrumentation
# (need repo root as cwd for `prism`/`benchmarks` imports to resolve) -
# never a real deliverable, deleted after use.
_scratch_*.py
# reports/ holds generated run output, ignored by default - except
# hand-authored, reviewable methodology docs, which are real
# deliverables, not generated output. (A bare "reports/" pattern would
# exclude the directory itself, which git cannot un-exclude per-file no
# matter how the negations below are written - "reports/*" excludes
# only its current contents, leaving the directory open to negation.)
reports/*
!reports/pilot/
reports/pilot/*
!reports/pilot/methodology.md

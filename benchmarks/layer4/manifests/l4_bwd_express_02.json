 "tests": [
  "res .format(obj) given .default should be able to invoke other formatter",
  "res .format(obj) given .default should be invoked instead of auto-responding",
  "res .format(obj) given .default should work when only .default is provided",
  "res .format(obj) in router should Vary: Accept",
  "res .format(obj) in router should allow wildcard type/subtypes",
  "res .format(obj) in router should default the Content-Type",
  "res .format(obj) in router should set the correct charset for the Content-Type",
  "res .format(obj) in router should utilize qvalues in negotiation",
  "res .format(obj) in router when Accept is not present should invoke the first callback",
  "res .format(obj) in router when no match is made should should respond with 406 not acceptable",
  "res .format(obj) with canonicalized mime types should Vary: Accept",
  "res .format(obj) with canonicalized mime types should allow wildcard type/subtypes",
  "res .format(obj) with canonicalized mime types should default the Content-Type",
  "res .format(obj) with canonicalized mime types should set the correct charset for the Content-Type",
  "res .format(obj) with canonicalized mime types should utilize qvalues in negotiation",
  "res .format(obj) with canonicalized mime types when Accept is not present should invoke the first callback",
  "res .format(obj) with canonicalized mime types when no match is made should should respond with 406 not acceptable",
  "res .format(obj) with extnames should Vary: Accept",
  "res .format(obj) with extnames should allow wildcard type/subtypes",
  "res .format(obj) with extnames should default the Content-Type",
  "res .format(obj) with extnames should set the correct charset for the Content-Type",
  "res .format(obj) with extnames should utilize qvalues in negotiation",
  "res .format(obj) with extnames when Accept is not present should invoke the first callback",

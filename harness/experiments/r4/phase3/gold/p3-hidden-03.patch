+import importlib
+
+
+def test_phase3_rename_build_from_header():
+    owner = importlib.import_module('werkzeug.datastructures.range')
+    owner = getattr(owner, 'Range')
+    assert hasattr(owner, 'build_from_header')
+    assert not hasattr(owner, 'from_header')

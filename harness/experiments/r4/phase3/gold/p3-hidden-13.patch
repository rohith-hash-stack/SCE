@@ -0,0 +1,8 @@
+import importlib
+
+
+def test_phase3_rename_dispatch_bytes():
+    owner = importlib.import_module('aiohttp.web_ws')
+    owner = getattr(owner, 'WebSocketResponse')
+    assert hasattr(owner, 'dispatch_bytes')
+    assert not hasattr(owner, 'send_bytes')

index 00000000..a3302f7e
--- /dev/null
+++ b/tests/test_phase2_signature_parse_dict_header.py
@@ -0,0 +1,8 @@
+import importlib
+import inspect
+
+
+def test_phase2_keyword_only_value():
+    owner = importlib.import_module('werkzeug.http')
+    p = inspect.signature(getattr(owner, 'parse_dict_header')).parameters['value']
+    assert p.kind is inspect.Parameter.KEYWORD_ONLY

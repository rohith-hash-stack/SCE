diff --git a/tests/coverage/test_phase2_signature_analyze.py b/tests/coverage/test_phase2_signature_analyze.py
new file mode 100644
index 0000000..4b65e3b
--- /dev/null
+++ b/tests/coverage/test_phase2_signature_analyze.py
@@ -0,0 +1,9 @@
+import importlib
+import inspect
+
+
+def test_phase2_keyword_only_json_str():
+    owner = importlib.import_module('instructor.v2.dsl.json_tracker')
+    owner = getattr(owner, 'JsonCompleteness')
+    p = inspect.signature(getattr(owner, 'analyze')).parameters['json_str']
+    assert p.kind is inspect.Parameter.KEYWORD_ONLY

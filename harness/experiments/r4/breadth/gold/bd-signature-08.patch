diff --git a/tests/test_phase2_signature_finalize.py b/tests/test_phase2_signature_finalize.py
new file mode 100644
index 0000000..984b0ea
--- /dev/null
+++ b/tests/test_phase2_signature_finalize.py
@@ -0,0 +1,9 @@
+import importlib
+import inspect
+
+
+def test_phase2_keyword_only_msg():
+    owner = importlib.import_module('packaging.errors')
+    owner = getattr(owner, '_ErrorCollector')
+    p = inspect.signature(getattr(owner, 'finalize')).parameters['msg']
+    assert p.kind is inspect.Parameter.KEYWORD_ONLY

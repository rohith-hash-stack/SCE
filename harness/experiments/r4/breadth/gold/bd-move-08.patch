diff --git a/sqlglot/transforms_remove_unique_constraints.py b/sqlglot/transforms_remove_unique_constraints.py
new file mode 100644
index 00000000..e926dd0c
--- /dev/null
+++ b/sqlglot/transforms_remove_unique_constraints.py
@@ -0,0 +1,11 @@
+from __future__ import annotations
+from sqlglot import expressions as exp
+
+
+def remove_unique_constraints(expression: exp.Expr) -> exp.Expr:
+    assert isinstance(expression, exp.Create)
+    for constraint in expression.find_all(exp.UniqueColumnConstraint):
+        parent = constraint.parent
+        (parent if isinstance(parent, (exp.ColumnConstraint, exp.Constraint)) else constraint).pop()
+
+    return expression

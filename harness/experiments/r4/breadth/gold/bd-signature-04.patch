diff --git a/tests/test_phase2_signature_fields.py b/tests/test_phase2_signature_fields.py
new file mode 100644
index 0000000..4455b24
--- /dev/null
+++ b/tests/test_phase2_signature_fields.py
@@ -0,0 +1,8 @@
+import importlib
+import inspect
+
+
+def test_phase2_keyword_only_type():
+    owner = importlib.import_module('cattrs._compat')
+    p = inspect.signature(getattr(owner, 'fields')).parameters['type']
+    assert p.kind is inspect.Parameter.KEYWORD_ONLY

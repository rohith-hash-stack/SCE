+    def _finalize_parsed_result(
+        self,
+        response_model: type[BaseModel] | ParallelBase,
+        response: Any,
+        parsed: Any,
+    ) -> Any:
+        """Normalize common DSL results without interpreting provider payloads."""
+        from instructor.v2.dsl.iterable import IterableBase

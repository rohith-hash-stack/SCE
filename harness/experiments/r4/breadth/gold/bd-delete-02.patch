+        if isinstance(response_model, ParallelBase):
+            return parsed
+        if isinstance(parsed, AdapterBase):
+            return parsed.content
+        if isinstance(parsed, BaseModel):
+            parsed._raw_response = response  # type: ignore[attr-defined]
+        return parsed

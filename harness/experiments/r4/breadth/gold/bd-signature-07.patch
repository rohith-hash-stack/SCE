diff --git a/tests/test_phase2_signature_error.py b/tests/test_phase2_signature_error.py
new file mode 100644
index 0000000..e6164a2
--- /dev/null
+++ b/tests/test_phase2_signature_error.py
@@ -0,0 +1,9 @@
+import importlib
+import inspect
+
+
+def test_phase2_keyword_only_error():
+    owner = importlib.import_module('packaging.errors')
+    owner = getattr(owner, '_ErrorCollector')
+    p = inspect.signature(getattr(owner, 'error')).parameters['error']
+    assert p.kind is inspect.Parameter.KEYWORD_ONLY

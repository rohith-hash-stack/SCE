diff --git a/tests/test_phase2_signature_astimezone.py b/tests/test_phase2_signature_astimezone.py
new file mode 100644
index 0000000..d7fd8d4
--- /dev/null
+++ b/tests/test_phase2_signature_astimezone.py
@@ -0,0 +1,9 @@
+import importlib
+import inspect
+
+
+def test_phase2_keyword_only_tz():
+    owner = importlib.import_module('arrow.arrow')
+    owner = getattr(owner, 'Arrow')
+    p = inspect.signature(getattr(owner, 'astimezone')).parameters['tz']
+    assert p.kind is inspect.Parameter.KEYWORD_ONLY

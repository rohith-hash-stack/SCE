diff --git a/tests/test_phase2_signature_get_locale.py b/tests/test_phase2_signature_get_locale.py
new file mode 100644
index 0000000..b54768d
--- /dev/null
+++ b/tests/test_phase2_signature_get_locale.py
@@ -0,0 +1,8 @@
+import importlib
+import inspect
+
+
+def test_phase2_keyword_only_name():
+    owner = importlib.import_module('arrow.locales')
+    p = inspect.signature(getattr(owner, 'get_locale')).parameters['name']
+    assert p.kind is inspect.Parameter.KEYWORD_ONLY

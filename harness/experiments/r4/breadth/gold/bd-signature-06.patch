@@ -0,0 +1,8 @@
+import importlib
+import inspect
+
+
+def test_phase2_keyword_only_obj():
+    owner = importlib.import_module('marshmallow.utils')
+    p = inspect.signature(getattr(owner, 'is_collection')).parameters['obj']
+    assert p.kind is inspect.Parameter.KEYWORD_ONLY

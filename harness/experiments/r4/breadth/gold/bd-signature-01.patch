diff --git a/tests/test_phase2_signature_append_payload.py b/tests/test_phase2_signature_append_payload.py
new file mode 100644
index 00000000..73dd3df2
--- /dev/null
+++ b/tests/test_phase2_signature_append_payload.py
@@ -0,0 +1,9 @@
+import importlib
+import inspect
+
+
+def test_phase2_keyword_only_payload():
+    owner = importlib.import_module('aiohttp.multipart')
+    owner = getattr(owner, 'MultipartWriter')
+    p = inspect.signature(getattr(owner, 'append_payload')).parameters['payload']
+    assert p.kind is inspect.Parameter.KEYWORD_ONLY
